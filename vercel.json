{
  "redirects": [
    { "source": "/ktds/", "destination": "/ktds", "permanent": false },
    { "source": "/ktds/kms", "destination": "/ktds/kms/", "permanent": true },
    { "source": "/kms", "destination": "/ktds/kms/", "permanent": true },
    { "source": "/kms/", "destination": "/ktds/kms/", "permanent": true },
    { "source": "/kms/:path+", "destination": "/ktds/kms/:path+", "permanent": true },
    { "source": "/", "has": [{ "type": "host", "value": "www.subi365.app" }], "destination": "/ktds", "permanent": false },
    { "source": "/", "has": [{ "type": "host", "value": "subi365.app" }], "destination": "/ktds", "permanent": false }
  ],
  "rewrites": [
    { "source": "/ktds/kms/", "destination": "https://ai-kms-beryl.vercel.app/" },
    { "source": "/ktds/kms/:path+", "destination": "https://ai-kms-beryl.vercel.app/:path+" },
    { "source": "/ktds/slides", "destination": "https://slide-liart.vercel.app/" },
    { "source": "/ktds/slides/", "destination": "https://slide-liart.vercel.app/" },
    { "source": "/ktds/slides/:path+", "destination": "https://slide-liart.vercel.app/:path+" },
    { "source": "/ktds", "destination": "https://ktds.cony.im/" },
    { "source": "/ktds/:path+", "destination": "https://ktds.cony.im/:path+" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.subi365.app" }], "destination": "https://ktds.cony.im/" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "subi365.app" }], "destination": "https://ktds.cony.im/" }
  ]
}
